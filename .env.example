# Optional: copy to .env (ignored by Git). Configure models, data and search in config.json.
# JSON service endpoints/models take precedence over these shared fallbacks.
R2AI_BASE_URL=https://your-service.example/v1

# Choose one credential source; never commit the key or its file.
# R2AI_API_KEY_FILE=/path/to/api-key.txt
# R2AI_API_KEY=your-key
# Different services can use role-specific credentials:
# R2AI_CRITIC_API_KEY_FILE=/path/to/critic-key.txt
# R2AI_JUDGE_API_KEY_FILE=/path/to/judge-key.txt

# Optional existing runtime and tokenizer resource directories.
# R2AI_PYTHON=/path/to/venv/bin/python
# NLTK_DATA=/path/to/nltk_data
# Optional package mirror for installation (standard pip variables also apply).
# R2AI_TORCH_INDEX_URL=https://your-mirror.example/pytorch/cu129
TOKENIZERS_PARALLELISM=false
