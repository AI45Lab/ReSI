+def _make_category_trainer(submitted: dict[str, int], quotas: dict[str, int], batch_size: int = 64):
+    trainer = object.__new__(_ConcretePPOTrainer)
+    trainer._bounded_category_refill = True
+    trainer._phase_submitted_counts = Counter(submitted)
+    trainer._phase_category_quotas = quotas
+    trainer.config = SimpleNamespace(data=SimpleNamespace(train_batch_size=batch_size))
+    requested = []
+    submitted_batches = []
+    trainer._next_train_batch = lambda count=None: requested.append(count) or object()
+    trainer._submit_batch_to_rollout = submitted_batches.append
+    return trainer, requested, submitted_batches
+
+
+def test_category_phase_submits_full_batch_when_enough_prompts_remain():
+    trainer, requested, submitted = _make_category_trainer(
+        {"harmful": 0, "benign": 0, "dapo_math": 0},
+        {"harmful": 1024, "benign": 1024, "dapo_math": 1024},
+    )
+    PPOTrainer._add_batch_to_generate(trainer)
+    assert requested == [64]
+    assert len(submitted) == 1
+
+
