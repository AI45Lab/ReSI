+def test_sync_dapo_refills_same_category_once_without_recursive_retry(tq_init, partition_id, monkeypatch):
+    """One harmful no-signal group gets one harmful replacement and no second retry."""
+    monkeypatch.setenv("R2AI_CATEGORY_REPLAY_ENABLED", "1")
+    all_same = PromptSpec(
+        uid=_uid(), status="finished", sessions=2, rewards=[0.0, 0.0], category="harmful"
+    )
+    mixed = PromptSpec(uid=_uid(), status="finished", sessions=2, rewards=[0.0, 1.0], category="benign")
+    _produce(partition_id, [all_same, mixed]).join_and_check()
+
+    calls: list[dict[str, int]] = []
+    outcomes: list[dict] = []
+
+    def category_refill(counts: dict[str, int]) -> int:
+        calls.append(dict(counts))
+        specs = [
+            PromptSpec(
+                uid=_uid(),
+                status="finished",
+                sessions=2,
+                rewards=[0.0, 0.0],
+                category=category,
+                refill_attempt=1,
+            )
+            for category, count in counts.items()
+            for _ in range(count)
+        ]
+        _produce(partition_id, specs).join_and_check()
+        return len(specs)
+
+    rb = _make_rb(
+        refill_fn=lambda _count: pytest.fail("generic refill must not be used"),
+        refill_by_category_fn=category_refill,
+        outcome_fn=outcomes.append,
+        filter_groups_metric="acc",
+    )
+    try:
+        batch, metrics = rb.sample(global_steps=1, partition_id=partition_id, batch_size=2)
+        assert len(_uids_of(batch.keys)) == 1
+        assert mixed.uid in _uids_of(batch.keys)
+        assert all_same.uid not in _uids_of(batch.keys)
+        assert calls == [{"harmful": 1}]
+        terminals = [event for event in outcomes if event["event"] == "terminal"]
+        assert sorted(event["disposition"] for event in terminals) == [
+            "dropped_no_signal", "effective", "retry_scheduled"
+        ]
+        assert sum(event["event"] == "selected" for event in outcomes) == 1
+        assert metrics["validation/filter_groups/evicted_samples"] == 2
+        assert metrics["validation/category_replay/dropped_no_signal_groups"] == 1
+    finally:
+        _clear_partition(partition_id)
+
+
