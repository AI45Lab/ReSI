+def validate_peft_adapter_output(adapter_dir: str | Path) -> None:
+    """Raise when a PEFT adapter directory cannot be loaded safely."""
+    from safetensors import safe_open
+
+    adapter_dir = Path(adapter_dir)
+    config_path = adapter_dir / "adapter_config.json"
+    weights_path = adapter_dir / "adapter_model.safetensors"
+    errors = []
+
+    if not _is_nonempty_file(config_path):
+        errors.append("missing or empty adapter_config.json")
+    else:
+        try:
+            config = json.loads(config_path.read_text(encoding="utf-8"))
+            if not isinstance(config, dict) or int(config.get("r", 0)) <= 0:
+                errors.append("adapter_config.json has no positive LoRA rank")
+        except (OSError, UnicodeError, ValueError, TypeError, json.JSONDecodeError) as exc:
+            errors.append(f"invalid adapter_config.json: {exc}")
+
+    if not _is_nonempty_file(weights_path):
+        errors.append("missing or empty adapter_model.safetensors")
+    else:
+        try:
+            with safe_open(weights_path, framework="pt", device="cpu") as weights:
+                keys = list(weights.keys())
+            if not keys or not all("lora_" in key for key in keys):
+                errors.append("adapter_model.safetensors has no valid LoRA tensors")
+        except Exception as exc:
+            errors.append(f"invalid adapter_model.safetensors: {exc}")
+
+    if errors:
+        raise RuntimeError(f"Incomplete PEFT adapter output at {adapter_dir}: {'; '.join(errors)}")
